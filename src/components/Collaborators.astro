---
import caloImage from '../assets/calo.png';
import eugeImage from '../assets/eugenia.png';

const colaboradores = [
  {
    nombre: "Carlos Yonusg",
    rol: "Narrador, editor, programador",
    imagen: caloImage.src,
    titulo: "La humildad exalta al hombre al cielo de la gloria y poder.",
    descripcion: "Crear herramientas que permitan comunion con Dios en el mundo digital.",
    fecha: "",
    lectura: ""
  },
  {
    nombre: "Eugenia Araujo",
    rol: "Narradora",
    imagen: eugeImage.src,
    titulo: "Cuidar las palabras es preservar el mensaje",
    descripcion: "Sois los frutos de un solo árbol y las hojas de una sola rama. Trataos unos a otros con extremo amor y armonía, con amistad y compañerismo… Tan potente es la luz de la unidad que puede iluminar toda la tierra",
    fecha: "",
    lectura: ""
  }
];

---
<section class="flex items-center justify-center">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 px-4 py-6" id="colaboradores">
    <h2 class="col-span-full text-2xl text-brand-primary font-bold">
      Conoce a nuestros colaboradores
    </h2>
  {colaboradores.map((colaborador) => (
    <a href="#" class="block rounded-md border border-gray-300 p-4 shadow-sm sm:p-6">
      <div class="sm:flex sm:justify-between sm:gap-4 lg:gap-6">
        <div class="sm:order-last sm:shrink-0">
          <img
            alt={`Foto de ${colaborador.nombre}`}
            src={colaborador.imagen}
            class="size-16 rounded-full object-cover sm:size-[72px]"
          />
        </div>

        <div class="mt-4 sm:mt-0">
          <h3 class="text-lg font-medium text-pretty text-gray-900">
            {colaborador.nombre}
          </h3>

          <p class="mt-1 text-sm text-gray-700 ">{colaborador.rol}</p>

          <p class="mt-4 line-clamp-2 text-sm text-pretty text-gray-700">
            {colaborador.descripcion}
          </p>
        </div>
      </div>
    </a>
  ))}
</div>
</section>

