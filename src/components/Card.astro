---
interface Props {
  title: string;
  imgSrc: string | null;
  pubDate: string;
  description: string;
  url: string;
  target?: string;
  pdfUrl?: string;
  tags?: string[];
  voices?: string[];
}

const { 
  title, 
  imgSrc, 
  pubDate, 
  description, 
  url, 
  target, 
  pdfUrl, 
  tags = [], 
  voices = [] 
} = Astro.props;
const isDisabled = url === "#";
const id = `modal-${Math.random().toString(36).substr(2, 9)}`;
---

<article class="flex flex-col bg-white transition hover:shadow-xl shadow-md rounded-lg overflow-hidden cursor-pointer" onclick={`document.getElementById('${id}').classList.remove('hidden')`}>
  <!-- Imagen del libro -->
  <div class="relative">
    {imgSrc ? (
      <img
        alt={title}
        src={imgSrc}
        class="aspect-square h-full w-full object-cover"
      />
    ) : (
      <img
        alt="Placeholder"
        src="/images/placeholder.png"
        class="aspect-square h-full w-full object-cover"
      />
    )}
    <div class="absolute top-0 right-0 bg-white/75 p-2 rounded-bl-lg">
      <time datetime={pubDate} class="block text-xs text-gray-700">
        {pubDate}
      </time>
    </div>
  </div>

  <!-- Contenido del libro -->
  <div class="flex-1 flex flex-col p-4 sm:p-6">
    <div class="flex-1">
      <h3 class="font-bold text-custom-gold uppercase">
        {title}
      </h3>
      <p class="mt-2 line-clamp-3 text-sm/relaxed text-gray-700">
        {description}
      </p>
    </div>
    
    <!-- Botones de acción -->
    <div class="mt-4 flex flex-wrap gap-2">
      {!isDisabled && (
        <a
          href={url}
          target={target}
          class="flex-1 min-w-[120px] text-center bg-[#a27e26] hover:bg-[#8a6c21] text-white text-sm font-medium py-2 px-3 rounded transition flex items-center justify-center gap-1"
          onclick="event.stopPropagation()"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
          </svg>
          Escuchar
        </a>
      )}
      
      {pdfUrl && (
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 min-w-[120px] text-center bg-gray-200 hover:bg-gray-300 text-gray-800 text-sm font-medium py-2 px-3 rounded transition flex items-center justify-center gap-1"
          onclick="event.stopPropagation()"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          Ver PDF
        </a>
      )}
    </div>
  </div>

  <!-- Modal/Popup -->
  <div id={id} class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" onclick="event.stopPropagation(); this.classList.add('hidden')">
    <div class="bg-white rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
      <div class="p-6">
        <div class="flex justify-between items-start mb-4">
          <h3 class="text-2xl font-bold text-custom-gold">{title}</h3>
          <button 
            onclick={`document.getElementById('${id}').classList.add('hidden')`}
            class="text-gray-400 hover:text-gray-600"
            aria-label="Cerrar"
          >
            ✕
          </button>
        </div>
        
        <div class="space-y-4">
          <div>
            <h4 class="font-semibold">Sinopsis:</h4>
            <p class="text-gray-700">{description}</p>
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <h4 class="font-semibold">Idioma:</h4>
              <p>{tags.length > 0 ? tags.join(', ') : 'No especificado'}</p>
            </div>
            <div>
              <h4 class="font-semibold">Narrador:</h4>
              <p>{voices && voices.length > 0 ? voices.join(', ') : 'Por definir'}</p>
            </div>
          </div>
          
          <div class="pt-4 flex flex-col space-y-2">
            {!isDisabled && (
              <a
                href={url}
                target={target}
                class="w-full text-center bg-[#a27e26] hover:bg-[#8a6c21] text-white font-bold py-2 px-4 rounded transition"
              >
                Escuchar
              </a>
            )}
            
            {pdfUrl && (
              <a
                href={pdfUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full text-center bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded transition"
              >
                Ver PDF
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</article>