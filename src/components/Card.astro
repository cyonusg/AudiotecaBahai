---
interface Props {
  title: string;
  imgSrc: string | null;
  pubDate: string;
  description: string;
  url: string;
  target?: string;
  pdfUrl?: string;
}

const { title, imgSrc, pubDate, description, url, target, pdfUrl } = Astro.props;
const isDisabled = url === "#";
---

<article class="flex flex-col bg-white transition hover:shadow-xl shadow-md rounded-lg overflow-hidden">
  
  <!-- Imagen del libro -->
  <div class="relative">
    {imgSrc ? (
      <img
        alt={title}
        src={imgSrc}
        class="aspect-square h-full w-full object-cover"
      />
    ) : (
      <img
        alt="Placeholder"
        src="/images/placeholder.png"
        class="aspect-square h-full w-full object-cover"
      />
    )}
    <div class="absolute top-0 right-0 bg-white/75 p-2 rounded-bl-lg">
      <time
          datetime={pubDate}
          class="block text-xs text-gray-700"
        >
          {pubDate}
        </time>
    </div>
  </div>

  <!-- Contenido del libro -->
  <div class="flex flex-1 flex-col justify-between p-4 sm:p-6">
    <div>
      <h3 class="font-bold text-custom-gold uppercase">
        {title}
      </h3>

      <p class="mt-2 line-clamp-3 text-sm/relaxed text-gray-700">
        {description}
      </p>
    </div>

    <div class="mt-4">
      <a
        href={isDisabled ? undefined : url}
        target={target}
        class:list={[
          "block w-full rounded px-5 py-3 text-center text-xs font-bold uppercase text-white transition mb-2",
          isDisabled
            ? "bg-gray-400 cursor-not-allowed"
            : "bg-[#a27e26] hover:bg-[#8a6c21]"
        ]}
        aria-disabled={isDisabled}
      >
        {isDisabled ? "Próximamente" : "Escuchar"}
      </a>
      {pdfUrl && (
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block text-center text-xs text-gray-600 hover:text-indigo-600 transition-colors"
        >
          Ver PDF
        </a>
      )}
    </div>
  </div>
</article>