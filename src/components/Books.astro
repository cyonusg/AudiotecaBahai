---
import { getCollection } from "astro:content";
import Card from './Card.astro';

// Obtener colecciones
const books = await getCollection("books");
const mcuj = await getCollection("mcuj");
const prayers = await getCollection("prayers");

// Lógica para imágenes
const images = import.meta.glob('../assets/*.{png,jpg,jpeg,webp}');
const getImage = async (imgName: string) => {
  if (!imgName) return null;
  const imagePath = `../assets/${imgName}`;
  const imageModule = images[imagePath] ? await images[imagePath]() : null;
  return imageModule?.default.src;
};

// Preparar datos con imágenes
const booksWithImages = await Promise.all(
  books.map(async (book) => ({
    ...book,
    img: await getImage(book.data.image)
  }))
);

const mcujWithImages = await Promise.all(
  mcuj.map(async (message) => ({
    ...message,
    img: await getImage(message.data.image)
  }))
);

const prayersWithImages = await Promise.all(
  prayers.map(async (prayer) => ({
    ...prayer,
    img: await getImage(prayer.data.image)
  }))
);
---

<section id="content" class="p-4 pt-3 lg:pt-4">
  <div class="container mx-auto">
    <!-- Tabs Navigation -->
    <div class="flex space-x-2 mb-8 overflow-x-auto pb-2">
      <button 
        data-tab="books" 
        class="px-4 py-2 rounded-t-lg font-medium transition-colors bg-[#a27e26] text-white"
        onclick="setActiveTab('books')"
      >
        Libros
      </button>
      <button 
        data-tab="prayers" 
        class="px-4 py-2 rounded-t-lg font-medium transition-colors bg-gray-100 hover:bg-gray-200"
        onclick="setActiveTab('prayers')"
      >
        Oraciones
      </button>
      <button 
        data-tab="mcuj" 
        class="px-4 py-2 rounded-t-lg font-medium transition-colors bg-gray-100 hover:bg-gray-200"
        onclick="setActiveTab('mcuj')"
      >
        Mensajes de la Casa Universal de Justicia
      </button>
    </div>

    <!-- Books Content -->
    <div id="books-content" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {booksWithImages.map((book) => (
        <Card 
          title={book.data.title}
          imgSrc={book.img}
          pubDate={book.data.pubDate}
          description={book.body}
          url={book.data.url}
          target={book.data.target}
          pdfUrl={book.data.pdfUrl}
          tags={book.data.tags || []}
          voices={book.data.voices || []}
        />
      ))}
    </div>

    <!-- Prayers Content (initially hidden) -->
    <div id="prayers-content" class="hidden grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {prayersWithImages.map((prayer) => (
        <Card 
          title={prayer.data.title}
          imgSrc={prayer.img}
          pubDate={prayer.data.pubDate}
          description={prayer.body}
          url={prayer.data.url}
          target={prayer.data.target}
          pdfUrl={prayer.data.pdfUrl}
          tags={prayer.data.tags || []}
          voices={prayer.data.voices || []}
        />
      ))}
    </div>

    <!-- MCUJ Content (initially hidden) -->
    <div id="mcuj-content" class="hidden grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {mcujWithImages.map((message) => (
        <Card 
          title={message.data.title}
          imgSrc={message.img}
          pubDate={message.data.pubDate}
          description={message.body}
          url={message.data.url}
          target={message.data.target}
          tags={message.data.tags || []}
          voices={message.data.voices || []}
        />
      ))}
    </div>
  </div>

  <script is:inline>
    function setActiveTab(tab) {
      // Hide all content
      document.querySelectorAll('[id$="-content"]').forEach(el => {
        el.classList.add('hidden');
        el.classList.remove('grid');
      });
      
      // Show selected content
      const content = document.getElementById(`${tab}-content`);
      if (content) {
        content.classList.remove('hidden');
        content.classList.add('grid');
      }
      
      // Update tab styles
      document.querySelectorAll('[data-tab]').forEach(btn => {
        if (btn.dataset.tab === tab) {
          btn.classList.add('bg-[#a27e26]', 'text-white');
          btn.classList.remove('bg-gray-100', 'hover:bg-gray-200');
        } else {
          btn.classList.remove('bg-[#a27e26]', 'text-white');
          btn.classList.add('bg-gray-100', 'hover:bg-gray-200');
        }
      });
    }
    
    // Set initial active tab
    document.addEventListener('DOMContentLoaded', () => setActiveTab('books'));
  </script>

  <style>
    [id$="-content"] {
      transition: opacity 0.3s ease;
    }
  </style>
</section>
