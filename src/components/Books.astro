---
import { getCollection } from "astro:content";
import Card from './Card.astro'; // <-- 1. IMPORTAR EL NUEVO COMPONENTE

// Obtener colecciones
const books = await getCollection("books");
const mcuj = await getCollection("mcuj");
const prayers = await getCollection("prayers");

// Lógica para imágenes (sin cambios)
const images = import.meta.glob('../assets/*.{png,jpg,jpeg,webp}');
const getImage = async (imgName: string) => {
  if (!imgName) return null;
  const imagePath = `../assets/${imgName}`;
  const imageModule = images[imagePath] ? await images[imagePath]() : null;
  return imageModule?.default.src;
};

// Preparar datos con imágenes
const booksWithImages = await Promise.all(
  books.map(async (book:any) => ({
    ...book,
    img: await getImage(book.data.image),
  })),
);

const mcujWithImages = await Promise.all(
  mcuj.map(async (message:any) => ({
    ...message,
    img: await getImage(message.data.image),
  }))
);

const prayersWithImages = await Promise.all(
  prayers.map(async (message:any) => ({
    ...message,
    img: await getImage(message.data.image),
  }))
);
---

<section id="books" class="p-4 pt-3 lg:pt-4">
  <div class="container mx-auto">

    <!-- SECCIÓN DE AUDIOLIBROS -->
    <div>
      <h2 class="text-2xl font-bold text-brand-primary mb-8 text-center">
        Audiolibros publicados
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 justify-items-center">
        {booksWithImages.map((book) => (
          <Card 
            title={book.data.title}
            imgSrc={book.img}
            pubDate={book.data.pubDate}
            description={book.body}
            url={book.data.url}
            target={book.data.target}
            pdfUrl={book.data.pdfUrl}
          />
        ))}
      </div>
    </div>

    <!-- SECCIÓN DE MENSAJES -->
    <div class="mt-12">
      <h2 class="text-2xl font-bold text-brand-primary text-center pb-4">
        Mensajes de la Casa Universal de Justicia
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 pt-2 justify-items-center">
        {mcujWithImages.map((message) => (
          <Card 
            title={message.data.title}
            imgSrc={message.img}
            pubDate={message.data.pubDate}
            description={message.body}
            url={message.data.url}
            target={message.data.target}
          />
        ))}
      </div>
    </div>

    <!-- SECCIÓN DE ORACIONES -->
    <div
    class:list={[
      "mt-4",
      prayers.length === 0 ? "hidden" : ""
    ]}>
      <h2 class="text-2xl font-bold text-brand-primary text-center">
        Selección de Oraciones
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 pt-2 justify-items-center">
        {prayersWithImages.map((prayer) => (
          <Card 
            title={prayer.data.title}
            imgSrc={prayer.img}
            pubDate={prayer.data.pubDate}
            description={prayer.body}
            url={prayer.data.url}
            target={prayer.data.target}
            pdfUrl={prayer.data.pdfUrl}
          />
        ))}
      </div>
    </div>

  </div>
</section>
