---
import { getCollection, getEntryBySlug, render } from "astro:content";
const entry = await getCollection("books");
const { Content } = await render(entry);
---

<section id="books" class="p-4 dark:bg-gray-900 pt-3 lg:pt-0">
  <h2 class="text-2xl font-bold text-indigo-600 dark:text-white mb-4 text-center">
    AudioLibros publicados
  </h2>
  {
    entry.map((book: any) => (
      <article class="flex bg-white transition hover:shadow-xl dark:bg-gray-900 dark:shadow-gray-800/25 mb-4 shadow-md rounded-lg">
        <div class="rotate-180 p-2 [writing-mode:_vertical-lr]">
          <time
            datetime="2022-10-10"
            class="flex items-center justify-between gap-4 text-xs font-bold text-gray-900 uppercase dark:text-white"
          >
            <span>{book.data.pubDate}</span>
            <span class="w-px flex-1 bg-gray-900/10 dark:bg-white/10" />
            <span>Publicación</span>
          </time>
        </div>

        <div class="hidden sm:block sm:basis-56">
          <img
            alt=""
            src="https://images.unsplash.com/photo-1609557927087-f9cf8e88de18?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1740&q=80"
            class="aspect-square h-full w-full object-cover"
          />
        </div>

        <div class="flex flex-1 flex-col justify-between">
          <div class="border-s border-gray-900/10 p-4 sm:!border-l-transparent sm:p-6 dark:border-white/10">
            <a href="#">
              <h3 class="font-bold text-gray-900 uppercase dark:text-white">
                {book.data.title}
              </h3>
            </a>

            <p class="mt-2 line-clamp-3 text-sm/relaxed text-gray-700 dark:text-gray-200">
              {book.data.description}
              <br />
            </p>

            <div class="prose dark:prose-invert mt-4">
              <Content />
            </div>
          </div>

          <div class="sm:flex sm:items-end sm:justify-end bg-white md:bg-custom-blue bg-official official-button">
            <a
              href={book.data.url}
              target={book.data.target}
              class="block  px-5 py-3 text-center text-xs font-bold text-gray-900 uppercase transition hover:bg-indigo-700 dark:text-white"
            >
              Escuchar
            </a>
          </div>
        </div>
      </article>
    ))
  }
  <style>
    .bg-official {
      background-color: white;
    }
    .official-button {
      transition: background-color 0.3s ease;
      background-color: var(--color-indigo-800);
    }
    .official-button a {

      color: white;
    }
  </style>
</section>
