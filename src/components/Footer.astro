---
import Logo from '../components/Logo.astro';

---
<footer class="bg-secondary">
  <div class="relative xs:items-center mx-auto max-w-screen-xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="flex items-center flex-col lg:justify-between ">
      <!-- Logo -->
      <div class="wrap-logo">
        <Logo />

      </div>

      <!-- Navigation Links -->
      <div class="mt-6 lg:mt-0">
        <nav aria-label="Footer Navigation">
          <ul class="flex flex-wrap justify-center gap-6 md:gap-8 lg:justify-end">
            <li>
              <a class="text-white transition a-official" href="/#quienesSomos">Quienes Somos</a>
            </li>
            <li>
              <a class="text-white transition a-official " href="/#content">AudioLibros</a>
            </li>
            <li>
              <a class="text-white transition  a-official" href="/#colaboradores">Colaboradores</a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-white">
      Copyright &copy; 2025. Todos los derechos reservados.
    </p>
    <div>
      <p class="text-center py-4 mb-6 mx-0 text-white"> Desarrollado por <a href="https://cyonusg.com" target="_blank" class="text-brand-primary font-bold">Cyonusg</a></p>
    </div>
  </div>
</footer>
<style>
  .wrap-logo {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 1rem;
    max-width: 219px;
  }

  .wrap-logo img {
    height: auto;
  }
  .a-official:hover {
    color: #a27e26;
  }
</style>