---
// src/pages/404.astro
// Puedes importar un Layout si usas uno general para tu sitio
// import Layout from '../layouts/Layout.astro'; // Ajusta la ruta si es necesario

// Si no usas un Layout general, necesitarás la estructura HTML básica:
const pageTitle = "404 - Página No Encontrada";
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  {/* Asegúrate que Tailwind esté enlazado, usualmente se maneja en el Layout o configuración de Astro */}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> {/* O tu favicon */}
  <meta name="generator" content={Astro.generator} />
</head>
<main class="flex items-center justify-center min-h-screen px-4">
    <div class="text-center max-w-md">
      <h1 class="text-6xl md:text-9xl font-bold text-blue-600 dark:text-blue-400">
        404 XD
      </h1>
      <p class="mt-4 text-2xl md:text-3xl font-semibold text-gray-800 dark:text-gray-200">
        Página No Encontrada
      </p>
      <p class="mt-2 text-md text-gray-600 dark:text-gray-400">
        Lo sentimos, la página que estás buscando no existe o ha sido movida.
      </p>
      <div class="mt-8">
        <a
          href="/"
          class="inline-block px-6 py-3 bg-blue-600 text-white font-medium text-sm leading-tight uppercase rounded-lg shadow-md hover:bg-blue-700 hover:shadow-lg focus:bg-blue-700 focus:shadow-lg focus:outline-none focus:ring-0 active:bg-blue-800 active:shadow-lg transition duration-150 ease-in-out"
        >
          Volver al Inicio
        </a>
      </div>
    </div>
  </main>
</html>