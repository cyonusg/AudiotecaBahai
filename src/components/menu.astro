---
import Logo from "./logo.astro";
---

<header class="bg-white py-1 shadow-md sticky top-0 z-100">
  <div class="mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <div class="flex-1 md:flex md:items-center wrap-logo">
        <a
          class="flex items-center text-teal-600 hover:text-teal-700 transition-colors"
          href="/#hero"
        >
        <Logo />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex md:items-center md:gap-6">
        <nav aria-label="Global">
          <ul class="flex items-center gap-6 text-sm">
            <li>
              <a
                class="text-gray-600 transition font-medium a-official"
                href="/#quienesSomos"
              >
                Quienes Somos
              </a>
            </li>
            <li>
              <a
                class="text-gray-600 transition font-medium a-official"
                href="/#books"
              >
                AudioLibros
              </a>
            </li>
            <li>
              <a
                class="text-gray-600 transition font-medium a-official"
                href="/#colaboradores"
              >
                Colaboradores
              </a>
            </li>
          </ul>
        </nav>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden">
        <button
          id="menu-btn"
          aria-label="Abrir menú"
          aria-expanded="false"
          class="p-2 text-gray-600 hover:text-indigo-600 rounded-md focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-600"
        >
          <svg
            id="menu-icon-open"
            class="h-6 w-6 block"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
          <svg
            id="menu-icon-close"
            class="h-6 w-6 hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Links -->
    <div
      id="mobile-menu"
      class="hidden md:hidden absolute top-full left-0 w-full bg-white shadow-lg py-2"
    >
      <ul class="flex flex-col space-y-1 px-4 pb-3 pt-2">
        <li>
          <a
            class="text-gray-600 transition hover:text-teal-600/75 font-medium a-official"
            href="/#quienesSomos"
          >
            Quienes Somos
          </a>
        </li>
        <li>
          <a
            class="text-gray-600 transition hover:text-teal-600/75 font-medium a-official"
            href="/#books"
          >
            AudioLibros
          </a>
        </li>
        <li>
          <a
            class="text-gray-600 transition hover:text-teal-600/75 font-medium a-official"
            href="/#colaboradores"
          >
            Colaboradores
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuLinks = document.querySelectorAll('a[href^="/#"]');
    const sections = Array.from(menuLinks).map((link) => {
      const targetId:any = link.getAttribute("href")?.substring(2); // Obtener el ID del destino
      return document.getElementById(targetId);
    });

    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.6, // Activar cuando el 60% de la sección esté visible
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const targetId = entry.target.id;
        const menuLink = document.querySelector(`a[href="/#${targetId}"]`);

        if (entry.isIntersecting) {
          menuLink?.classList.add("active"); // Activar el enlace
        } else {
          menuLink?.classList.remove("active"); // Desactivar el enlace
        }
      });
    }, observerOptions);

    sections.forEach((section) => {
      if (section) observer.observe(section);
    });

    // Cerrar el menú móvil al hacer clic en un enlace
    const mobileMenu = document.getElementById("mobile-menu");
    const menuBtn = document.getElementById("menu-btn");

    menuLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (mobileMenu && !mobileMenu.classList.contains("hidden")) {
          mobileMenu.classList.add("hidden");
          menuBtn?.setAttribute("aria-expanded", "false");
        }
      });
    });
  });
</script>

<style>
  .a-official:hover {
    color: var(--color-indigo-600);
  }

  .wrap-logo {
    max-width: 9em;
  }

  .active {
    color: var(--color-indigo-600); /* Cambiar el color del enlace activo */
    font-weight: bold; /* Opcional: resaltar el enlace activo */
  }
</style>
